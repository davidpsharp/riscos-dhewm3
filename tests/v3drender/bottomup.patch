diff --git a/core/v3d_bo.c b/core/v3d_bo.c
index d355673..1b7456d 100644
--- a/core/v3d_bo.c
+++ b/core/v3d_bo.c
@@ -115,7 +115,8 @@ range_free (struct v3d_dev *v3d, uint32_t p, uint32_t n)
 static int
 find_pages_aligned (struct v3d_dev *v3d, uint32_t n, uint32_t *first)
 {
-  uint32_t align = n >= 256 ? 256 : n >= 16 ? 16 : 1;
+  uint32_t align = 1;	/* riscos-doom3 test build: no top-down aligned placement */
+  (void) range_free;
   if (align > 1 && n < v3d->area_pages)
     for (uint32_t p = (v3d->area_pages - n) & ~(align - 1); p >= align; p -= align)
       if (range_free (v3d, p, n))
