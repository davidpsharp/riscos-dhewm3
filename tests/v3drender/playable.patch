diff --git a/core/v3d_bo.c b/core/v3d_bo.c
index d355673..bf3a581 100644
--- a/core/v3d_bo.c
+++ b/core/v3d_bo.c
@@ -150,11 +150,18 @@ v3d_bo_create_cached (struct v3d_dev *v3d, uint32_t bytes, int cached, int *bo_o
   if (at && at + n <= v3d->area_pages && range_free (v3d, at, n))
     first = at;				/* (0.13) the replay's address */
   else if (bo == V3D_MAX_BOS || !find_pages_aligned (v3d, n, &first))
-    return -V3D_ENOMEM;
+    {
+      plat_log (v3d, bo == V3D_MAX_BOS ? "BO: no BO slot left; pages" : "BO: no room in the area; pages", n);
+      return -V3D_ENOMEM;
+    }
   if (bo == V3D_MAX_BOS)
     return -V3D_ENOMEM;
   if (plat_pages_claim (v3d, first, n, cached))
-    return -V3D_ENOMEM;
+    {
+      plat_log (v3d, "BO: claim failed; pages", n);
+      plat_log (v3d, "  at area page", first);
+      return -V3D_ENOMEM;
+    }
   mark (v3d, first, n, 1);
   v3d->pages_used += n;
   struct v3d_bo *b = &v3d->bos[bo];
diff --git a/core/v3d_ioctl.c b/core/v3d_ioctl.c
index f79bb35..459e911 100644
--- a/core/v3d_ioctl.c
+++ b/core/v3d_ioctl.c
@@ -156,12 +156,18 @@ create_bo (struct v3d_dev *v3d, int f, struct drm_v3d_create_bo *args)
   for (h = 1; h < V3D_MAX_HANDLES && handles[h]; h++)
     ;
   if (h == V3D_MAX_HANDLES)
-    return -V3D_ENOSPC;
+    {
+      plat_log (v3d, "CREATE_BO: no handle left; size", args->size);
+      return -V3D_ENOSPC;
+    }
   v3d_service (v3d);
   int bo, ret = v3d_bo_create_cached (v3d, args->size,
 				      (args->flags & DRM_RISCOS_BO_CPU_CACHED) != 0, &bo);
   if (ret)
-    return ret;
+    {
+      plat_log (v3d, "CREATE_BO failed; size", args->size);
+      return ret;
+    }
   v3d->bos[bo].file = (int16_t) f;
   handles[h] = (uint16_t) bo;
   args->handle = h;
