+/* 2026: options with a tick, between Help and Quit, from the hint (or
+   system variable) SDL_RISCOS_MENU_OPTIONS: "Label=Variable;..." (at most
+   4). Each is ticked while its system variable is "on"; choosing it sets
+   the variable to "off" or "on", for the program to read. */
+#define RISCOS_MENU_OPTIONS_MAX 4
+static char riscos_option_label[RISCOS_MENU_OPTIONS_MAX][12];
+static char riscos_option_var[RISCOS_MENU_OPTIONS_MAX][48];
+static int riscos_options;
+
+static int riscos_iconbar_menu[7 + (3 + RISCOS_MENU_OPTIONS_MAX) * 6];
+static int riscos_menu_items[3 + RISCOS_MENU_OPTIONS_MAX];  /* item number -> RISCOS_MENU_* */
+static int riscos_menu_count;
+
+static void
+RISCOS_ReadMenuOptions(void)
+{
+    char list[200], *p, *next;
+    const char *hint = SDL_GetHint("SDL_RISCOS_MENU_OPTIONS");
+    riscos_options = 0;
+    if (hint)
+        SDL_strlcpy(list, hint, sizeof(list));
+    else if (_kernel_getenv("SDL_RISCOS_MENU_OPTIONS", list, sizeof(list)))
+        return;
+    for (p = list; p && *p && riscos_options < RISCOS_MENU_OPTIONS_MAX; p = next) {
+        char *eq;
+        next = SDL_strchr(p, ';');
+        if (next)
+            *next++ = 0;
+        eq = SDL_strchr(p, '=');
+        if (!eq || eq == p || !eq[1])
+            continue;
+        *eq = 0;
+        SDL_strlcpy(riscos_option_label[riscos_options], p, sizeof(riscos_option_label[0]));
+        SDL_strlcpy(riscos_option_var[riscos_options], eq + 1, sizeof(riscos_option_var[0]));
+        riscos_options++;
+    }
+}
+
+static SDL_bool
+RISCOS_OptionOn(int option)
+{
+    char value[8];
+    return !_kernel_getenv(riscos_option_var[option], value, sizeof(value))
+        && SDL_strcasecmp(value, "on") == 0;
+}
+
+/* The ticks, from the variables (the program may have changed them). */
+static void
+RISCOS_MenuTicks(void)
+{
+    int n;
+    for (n = 0; n < riscos_menu_count; n++) {
+        int k = riscos_menu_items[n] - RISCOS_MENU_OPTION;
+        int *item = &riscos_iconbar_menu[7 + 6 * n];
+        if (k >= 0)
+            item[0] = (item[0] & ~1) | (RISCOS_OptionOn(k) ? 1 : 0);
+    }
+}
 static int riscos_info_window = -1;
